{
  "name": "Horizon",
  "version": "1.0.0",
  "description": "Gives an open, forward-looking, and scalable feel.",
  "type": "module",
  "scripts": {
    "dev": "pnpm build && pnpm start",
    "start": "node --watch dist/server.js",
    "build": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "cli": "tsx lib/cli.ts",
    "init": "tsx lib/cli.ts init",
    "add": "tsx lib/cli.ts add",
    "commit": "tsx lib/cli.ts commit",
    "push": "tsx lib/cli.ts push",
    "pull": "tsx lib/cli.ts pull",
    "revert": "tsx lib/cli.ts revert",
    "worker": "bun redis/worker.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "Rajarshi Chakraborty",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.9.0",
  "devDependencies": {
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/helmet": "^4.0.0",
    "@types/ioredis": "^5.0.0",
    "@types/yargs": "^17.0.35",
    "bullmq": "^6.3.11",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "drizzle-orm": "1.0.0-rc.4",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "yargs": "^18.2.0",
    "zod": "^4.6.5"
  }
}
